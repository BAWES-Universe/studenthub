# copy php configuration
COPY ./nginx/php.conf /etc/nginx/php.conf

# load environment specific configuration
COPY ./nginx/railway-prod.conf /etc/nginx/sites-available/railway-prod.conf
RUN ln -s /etc/nginx/sites-available/railway-prod.conf /etc/nginx/sites-enabled/

# run default nginx config
RUN rm /etc/nginx/sites-enabled/default

# Expose port 80
EXPOSE 80

# Start Nginx and PHP-FPM
#CMD ["sh", "-c", "service nginx start && ./yii migrate && php-fpm"]
