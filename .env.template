# Environment Variables Template
# 
# Copy this file to .env and fill in your actual values:
#   cp .env.template .env
#
# IMPORTANT: Never commit .env to version control!
# The .env file is already in .gitignore

# ============================================
# Meilisearch Configuration
# ============================================
# Master key for Meilisearch API access
# Generate a strong random key (at least 32 characters)
# Example: openssl rand -hex 32
MEILI_MASTER_KEY=your_meilisearch_master_key_here

# ============================================
# MySQL Database Configuration
# ============================================
# Root password for MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# MySQL database name
MYSQL_DATABASE=studenthub

# MySQL user for application
MYSQL_USER=studenthubuser

# MySQL password for application user
MYSQL_PASSWORD=your_mysql_password_here

# ============================================
# Optional: Other Secrets
# ============================================
# If you have other API keys or secrets that should not be committed,
# add them here and reference them in your config files using getenv()
