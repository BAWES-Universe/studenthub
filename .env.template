# StudentHub Environment Variables Template
# Copy this file to .env and fill in your values
# For environment-specific configs, copy to environments/{dev|prod}/.env

# =============================================================================
# Database Configuration
# =============================================================================

# Main Database
DB_HOST=mysql
DB_NAME=studenthub
DB_USER=studenthubuser
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4

# Wallet Database
WALLET_DB_HOST=mysql
WALLET_DB_NAME=wallet
WALLET_DB_USER=studenthubuser
WALLET_DB_PASSWORD=your_password_here
WALLET_DB_CHARSET=utf8

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# =============================================================================
# Email/SMTP Configuration
# =============================================================================

SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_PORT=587
SMTP_ENCRYPTION=tls

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS S3 - Temporary Bucket (24hr expiry)
AWS_TEMP_BUCKET_KEY=your_aws_key
AWS_TEMP_BUCKET_SECRET=your_aws_secret
AWS_TEMP_BUCKET_NAME=studenthub-public-anyone-can-upload-24hr-expiry
AWS_TEMP_BUCKET_REGION=eu-west-2

# AWS S3 - Main Uploads Bucket
AWS_MAIN_BUCKET_REGION=eu-west-2
AWS_MAIN_BUCKET_NAME=studenthub-uploads

# AWS MediaConvert
AWS_MEDIACONVERT_REGION=eu-west-2
AWS_MEDIACONVERT_ENDPOINT=https://ey3xqwxpb.mediaconvert.eu-west-2.amazonaws.com
AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::438663597141:role/MediaConvertPermissions
AWS_MEDIACONVERT_QUEUE_ARN=arn:aws:mediaconvert:eu-west-2:438663597141:queues/Default

# AWS SQS (for EventManager)
AWS_SQS_REGION=eu-west-2
AWS_SQS_KEY=your_sqs_key
AWS_SQS_SECRET=your_sqs_secret
AWS_SQS_QUEUE=438663597141/Studenthub

# AWS ID Expiry Date Extractor
AWS_ID_EXTRACTOR_KEY=your_aws_key
AWS_ID_EXTRACTOR_SECRET=your_aws_secret

# =============================================================================
# Third-Party API Keys
# =============================================================================

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ReCaptcha
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# Algolia (Search)
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key

# IPStack (IP Geolocation)
IPSTACK_ACCESS_KEY=your_ipstack_key

# Cloudinary (Image Management)
CLOUDINARY_CLOUD_NAME=studenthub
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Jira
JIRA_URL=https://bawes-studenthub.atlassian.net
JIRA_EMAIL=your_jira_email
JIRA_API_TOKEN=your_jira_token

# Slack Webhook
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_USERNAME=StudentHub

# =============================================================================
# Application-Specific Configuration
# =============================================================================

# Wallet Manager
WALLET_API_KEY=your_wallet_api_key
WALLET_API_ENDPOINT=http://localhost/wallet/webhook/web/v1
WALLET_COMPANY_USER_ID=your_company_wallet_user_id

# Yeaster API
YEASTER_API_ENDPOINT=http://localhost:3001

# Xero Integration
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_TENANT_ID=your_xero_tenant_id

# =============================================================================
# URL Configuration
# =============================================================================

# Staff API Base URL
STAFF_API_BASE_URL=https://staff.api.dev.studenthub.co/v1

# Candidate API Base URL
CANDIDATE_API_BASE_URL=https://student.api.dev.studenthub.co/v1

# Verification Base URL
VERIFICATION_BASE_URL=https://v.dev.studenthub.co/
