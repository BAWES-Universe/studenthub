# StudentHub Environment Variables Template
# Copy this file to .env: cp .env.template .env
# Then run: docker-compose up -d
#
# This template contains default values for local Docker Compose development setup.
# For production, use .env.production as reference.

# =============================================================================
# Database Configuration
# =============================================================================

# Main Database (matches docker-compose.yaml MySQL service)
DB_HOST=mysql
DB_NAME=studenthub
DB_USER=studenthubuser
DB_PASSWORD=studenthub
DB_CHARSET=utf8mb4

# Database Slave (Production only - for read replicas)
DB_SLAVE_HOST=


# Test Database (for test-driven development)
TEST_DB_NAME=studenthub_test
# Note: TEST_DB_HOST, TEST_DB_USER, TEST_DB_PASSWORD, TEST_DB_CHARSET default to main DB values
# if not specified. They can be overridden for custom test database setups.

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_HOST=redis  # Use service name for Docker Compose
REDIS_PORT=6379
REDIS_DATABASE=0

# =============================================================================
# Email/SMTP Configuration
# =============================================================================

SMTP_SCHEME=smtp
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=587

# Mailer Configuration (use file transport in dev to avoid sending real emails)
MAILER_USE_FILE_TRANSPORT=true

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS S3 - Temporary Bucket (24hr expiry)
AWS_TEMP_BUCKET_KEY=
AWS_TEMP_BUCKET_SECRET=
AWS_TEMP_BUCKET_NAME=studenthub-public-anyone-can-upload-24hr-expiry
AWS_TEMP_BUCKET_REGION=eu-west-2

# AWS S3 - Main Uploads Bucket
AWS_MAIN_BUCKET_REGION=eu-west-2
AWS_MAIN_BUCKET_NAME=studenthub-uploads-dev-server

# AWS MediaConvert
AWS_MEDIACONVERT_REGION=eu-west-2
AWS_MEDIACONVERT_ENDPOINT=https://ey3xqwxpb.mediaconvert.eu-west-2.amazonaws.com
AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::438663597141:role/MediaConvertPermissions
AWS_MEDIACONVERT_QUEUE_ARN=arn:aws:mediaconvert:eu-west-2:438663597141:queues/Default

# AWS SQS (for EventManager)
AWS_SQS_REGION=eu-west-2
AWS_SQS_KEY=
AWS_SQS_SECRET=
AWS_SQS_QUEUE=438663597141/StudenthubDev

# AWS ID Expiry Date Extractor
AWS_ID_EXTRACTOR_KEY=
AWS_ID_EXTRACTOR_SECRET=

# =============================================================================
# Third-Party API Keys
# =============================================================================

# Google Maps
GOOGLE_MAPS_API_KEY=

# ReCaptcha
RECAPTCHA_SECRET_KEY=

# Sentry (Error Tracking) - Leave empty for local dev
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# Algolia (Search)
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=

# IPStack (IP Geolocation)
IPSTACK_ACCESS_KEY=

# Cloudinary (Image Management)
CLOUDINARY_CLOUD_NAME=studenthub
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Jira
JIRA_URL=https://bawes-studenthub.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack Webhook
SLACK_WEBHOOK_URL=
SLACK_USERNAME=StudentHub

# =============================================================================
# Application-Specific Configuration
# =============================================================================

# Wallet Manager
WALLET_API_KEY=
WALLET_API_ENDPOINT=http://localhost/wallet/webhook/web/v1
WALLET_COMPANY_USER_ID=

# Yeaster API
YEASTER_API_ENDPOINT=http://localhost:3001

# Xero Integration
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# =============================================================================
# URL Configuration
# =============================================================================

# Staff API Base URL
STAFF_API_BASE_URL=https://staff.api.dev.studenthub.co/v1

# Candidate API Base URL
CANDIDATE_API_BASE_URL=https://student.api.dev.studenthub.co/v1

# Verification Base URL
VERIFICATION_BASE_URL=https://v.dev.studenthub.co/

# =============================================================================
# Docker Compose Configuration
# =============================================================================

# MySQL Configuration
MYSQL_ROOT_PASSWORD=studenthub
MYSQL_SQL_MODE=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
MYSQL_PORT=3307

# Port Mappings (for direct access if needed)
ADMIN_PORT=21080
CANDIDATE_PORT=22080
COMPANY_PORT=23080
INSPECTOR_PORT=24080
STAFF_PORT=25080
VERIFICATION_PORT=26080
YEASTER_PORT=3001

# Traefik Ports
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
