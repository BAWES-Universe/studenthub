# Daily CRON at 1:30 PM Every Day
30 13 * * * /usr/local/bin/php ~/www/yii cron/daily > /dev/null 2>&1

# CRON every minute
* * * * * /usr/local/bin/php ~/www/yii cron/every-minute > /dev/null 2>&1
* * * * * /usr/local/bin/php ~/www/yii cron/process-transfer-files > /dev/null 2>&1

# Every Saturday
0 0 * * 6 /usr/local/bin/php ~/www/yii cron/weekly > /dev/null 2>&1

30 13 28 * * /usr/local/bin/php ~/www/yii cron/end-of-month

# Morning report at 8:00 AM every day
0 5 * * * /usr/local/bin/php ~/www/yii cron/summary > /dev/null 2>&1

# Payable reminder if any: every day
0 5 * * * /usr/local/bin/php ~/www/yii cron/payable-candidate-notification > /dev/null 2>&1

